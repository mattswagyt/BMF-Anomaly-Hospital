local function highlightTarget(target, color, tag)
    if target:FindFirstChild("BMF_Highlight") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "BMF_Highlight"
    highlight.Adornee = target
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255,255,255)
    highlight.FillTransparency = 0.5
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = target
    
    local cleanupMarker = Instance.new("StringValue")
    cleanupMarker.Name = "BMF_ESP_Tag"
    cleanupMarker.Value = tag
    cleanupMarker.Parent = target
end

local function createTracer(target, color, tag)
    if target:FindFirstChild("BMF_Tracer_Active_" .. tag) then return end
    local marker = Instance.new("Folder")
    marker.Name = "BMF_Tracer_Active_" .. tag
    marker.Parent = target

    local camera = workspace.CurrentCamera
    local line = Drawing.new("Line")

    line.Visible = true
    line.Color = color
    line.Thickness = 2

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if target and target:IsDescendantOf(workspace) and (target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")) then
            local root = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart")
            local pos, onScreen = camera:WorldToViewportPoint(root.Position)

            if onScreen then
                line.From = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
                line.To = Vector2.new(pos.X, pos.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
            connection:Disconnect()
            line:Remove()
        end
    end)
end

local function createNameTag(target, text, color, tag)
    if target:FindFirstChild("NameTag") then 
        target.NameTag.TextLabel.Text = text
        return 
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameTag"
    billboard.Size = UDim2.new(0,200,0,50)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 500
    billboard.Parent = target

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard
end

local function removeESPByTag(tag)
    for _, npc in ipairs(workspace:GetDescendants()) do
        local marker = npc:FindFirstChild("BMF_ESP_Tag")
        if marker and marker.Value == tag then
            if npc:FindFirstChild("BMF_Highlight") then npc.BMF_Highlight:Destroy() end
            if npc:FindFirstChild("NameTag") then npc.NameTag:Destroy() end
            local tracerMarker = npc:FindFirstChild("BMF_Tracer_Active_" .. tag)
            if tracerMarker then tracerMarker:Destroy() end
            marker:Destroy()
        end
    end
end

